# ---- フロントエンド（client）----
# 対戦サーバーの WebSocket URL（末尾の /ws は省略可）。本番ビルドの値は client/.env.production に書く
VITE_SERVER_URL=wss://kinggnu.yein.jp
# GitHub Pages 以外で配信する場合のベースパス（既定は /kinggnu/）
# VITE_BASE=/

# ---- 対戦サーバー（server / Node 版）----
PORT=8787
# 待ち受けアドレス（既定 127.0.0.1。トンネル経由でだけ公開する）
HOST=127.0.0.1
# 接続を許可するフロントエンドのオリジン（カンマ区切り、* で全許可）
ALLOWED_ORIGINS=https://dvyozakura.github.io,http://localhost:5173,capacitor://localhost,https://localhost
# 1 IP あたりの同時接続数
MAX_CONN_PER_IP=8

# アカウントの保存先（既定 server/data）
# DATA_DIR=server/data
# 以下の秘密情報は server/.env.local に書く（Git に入らない）
# REVENUECAT_SECRET_KEY=
# APPLE_BUNDLE_IDS=jp.yein.kinghorn
# GOOGLE_CLIENT_IDS=
# ALLOW_TEST_PURCHASES=0

# ---- アプリ版（mobile/）。GitHub の Variables に登録する公開キー ----
# VITE_REVENUECAT_IOS_KEY= / VITE_REVENUECAT_ANDROID_KEY=
# VITE_ADMOB_INTERSTITIAL_IOS= / VITE_ADMOB_INTERSTITIAL_ANDROID=
# ADMOB_APP_ID_IOS= / ADMOB_APP_ID_ANDROID=
# VITE_GOOGLE_WEB_CLIENT_ID= / VITE_GOOGLE_IOS_CLIENT_ID=

# ※ アクセストークンや API キーはこのファイルやリポジトリに書かないこと。
#   Cloudflare の API トークンは GitHub の Secrets（CLOUDFLARE_API_TOKEN）に登録する。
