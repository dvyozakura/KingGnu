# ---- フロントエンド（client）----
# 対戦サーバーの WebSocket URL（末尾は /ws）。GitHub Actions ではリポジトリの Variables に同名で設定する
VITE_SERVER_URL=wss://your-kinggnu-server.example.com/ws
# GitHub Pages 以外で配信する場合のベースパス（既定は /kinggnu/）
# VITE_BASE=/

# ---- 対戦サーバー（server / Node 版）----
PORT=8787
# 接続を許可するフロントエンドのオリジン（カンマ区切り、* で全許可）
ALLOWED_ORIGINS=https://your-github-name.github.io,http://localhost:5173
# 1 IP あたりの同時接続数
MAX_CONN_PER_IP=8

# ※ アクセストークンや API キーはこのファイルやリポジトリに書かないこと。
#   Cloudflare の API トークンは GitHub の Secrets（CLOUDFLARE_API_TOKEN）に登録する。
