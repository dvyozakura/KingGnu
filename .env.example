# ---- フロントエンド（client）----
# 対戦サーバーの WebSocket URL（末尾の /ws は省略可）。本番ビルドの値は client/.env.production に書く
VITE_SERVER_URL=wss://kinggnu.yein.jp
# GitHub Pages 以外で配信する場合のベースパス（既定は /kinggnu/）
# VITE_BASE=/

# ---- 対戦サーバー（server / Node 版）----
PORT=8787
# 待ち受けアドレス（既定 127.0.0.1。トンネル経由でだけ公開する）
HOST=127.0.0.1
# 接続を許可するフロントエンドのオリジン（カンマ区切り、* で全許可）
ALLOWED_ORIGINS=https://dvyozakura.github.io,http://localhost:5173
# 1 IP あたりの同時接続数
MAX_CONN_PER_IP=8

# ※ アクセストークンや API キーはこのファイルやリポジトリに書かないこと。
#   Cloudflare の API トークンは GitHub の Secrets（CLOUDFLARE_API_TOKEN）に登録する。
