{
  "name": "kinggnu",
  "private": true,
  "version": "1.0.0",
  "description": "KingGnu — 自分で描いた牛の角で殴り合う物理演算バトルゲーム",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client && npm run build -w server",
    "build:client": "npm run build -w client",
    "build:server": "npm run build -w server",
    "start:server": "npm run start -w server",
    "typecheck": "tsc -p shared && tsc -p client && tsc -p server",
    "test": "node --import tsx --test --test-reporter=spec shared/test/*.test.ts server/test/*.test.ts",
    "test:shared": "node --import tsx --test --test-reporter=spec shared/test/*.test.ts",
    "test:server": "node --import tsx --test --test-reporter=spec server/test/*.test.ts",
    "deploy:worker": "npm run deploy -w server"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
